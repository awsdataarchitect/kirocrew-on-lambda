#!/bin/bash
# `sudo` stand-in for the Remote Crew hub. The MicroVM runs with "no new privileges" set, so the real sudo refuses to start. The hub
# wraps every remote command as
#     echo <base64> | base64 -d | sudo -u <user> -i bash
# and the SSM agent (root) runs that. This does the one thing the wrapper needs: a login shell as the crew user (root -> crew) or,
# when already that user, as itself. Any other target user or option is refused: this is not a way to become someone else.
set -u
user=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n|-H|-i|-E) shift ;;
    -u) user=${2:-}; shift 2 ;;
    --) shift; break ;;
    -*) echo "sudo (compat): option $1 is not supported" >&2; exit 1 ;;
    *) break ;;
  esac
done
me=$(id -un)
target=${user:-$me}
if [ "$target" != "$me" ] && ! { [ "$me" = root ] && [ "$target" = crew ]; }; then
  echo "sudo (compat): cannot become $target; allowed: $me itself, or crew from root" >&2
  exit 1
fi
if [ "$target" = "$me" ]; then
  if [ $# -eq 0 ]; then exec bash -l; fi
  exec bash -lc "$*"
fi
if [ $# -eq 0 ]; then exec /usr/bin/setpriv --reuid=1000 --regid=1000 --init-groups /usr/bin/env HOME=/home/crew /usr/bin/bash -l; fi
exec /usr/bin/setpriv --reuid=1000 --regid=1000 --init-groups /usr/bin/env HOME=/home/crew /usr/bin/bash -lc "$*"
